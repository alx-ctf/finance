@page "/Error"
@using System.Diagnostics

<PageStyleLink Href="css/pages/error.css" />
<PageTitle>Ошибка</PageTitle>

<div class="page-error">
    <MudText Typo="Typo.h4" Class="ft-error-title">Ошибка</MudText>
    <MudText Typo="Typo.h6" Class="mb-4">При обработке запроса произошла ошибка.</MudText>

    @if (ShowRequestId)
    {
        <MudText Class="mb-4">
            <strong>ID запроса:</strong> <code>@RequestId</code>
        </MudText>
    }

    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        В production не включайте режим Development — он показывает детали исключений пользователям.
        Для отладки задайте переменную <code>ASPNETCORE_ENVIRONMENT=Development</code> и перезапустите приложение.
    </MudAlert>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
