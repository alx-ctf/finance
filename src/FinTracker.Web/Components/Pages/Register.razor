@page "/register"
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Регистрация</PageTitle>

<MudPaper Class="pa-6 ma-auto" Style="max-width:400px;margin-top:80px" Elevation="3">
    <MudText Typo="Typo.h5" Class="mb-4">Регистрация</MudText>
    <MudTextField @bind-Value="_email" Label="Email" Class="mb-3" />
    <MudTextField @bind-Value="_displayName" Label="Имя" Class="mb-3" />
    <MudTextField @bind-Value="_password" Label="Пароль" InputType="InputType.Password" Class="mb-4" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="RegisterAsync">Создать аккаунт</MudButton>
    <MudLink Href="/login" Class="mt-3 d-block">Уже есть аккаунт?</MudLink>
</MudPaper>

@code {
    private string _email = "";
    private string _displayName = "";
    private string _password = "";

    private async Task RegisterAsync()
    {
        var user = new ApplicationUser
        {
            UserName = _email,
            Email = _email,
            EmailConfirmed = true
        };
        var result = await UserManager.CreateAsync(user, _password);
        if (!result.Succeeded)
        {
            Snackbar.Add(string.Join("; ", result.Errors.Select(e => e.Description)), Severity.Error);
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: true);
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
