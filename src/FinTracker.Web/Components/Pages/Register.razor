@page "/register"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Регистрация</PageTitle>

<div class="page-register">
    <div class="ft-auth-card">
        <h1 class="ft-auth-title">Регистрация</h1>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="ft-auth-error" role="alert">@_error</div>
        }

        <form method="post" action="/auth/register" class="ft-auth-form">
            <AntiforgeryToken />
            <div class="ft-field">
                <label for="email">Email</label>
                <input id="email" type="email" name="Email" required autocomplete="username" placeholder="you@example.com" />
            </div>
            <div class="ft-field">
                <label for="password">Пароль</label>
                <input id="password" type="password" name="Password" required autocomplete="new-password"
                       minlength="6" placeholder="••••••••" />
                <span class="ft-hint">Мин. 6 символов, цифра, заглавная и строчная буква</span>
            </div>
            <button type="submit" class="ft-btn-primary">Создать аккаунт</button>
        </form>

        <div class="ft-auth-link-wrap">
            <a href="/login" class="ft-auth-link">Уже есть аккаунт?</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorCode { get; set; }

    private string? _error;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(ErrorCode))
            return;

        _error = ErrorCode == "empty"
            ? "Заполните email и пароль"
            : Uri.UnescapeDataString(ErrorCode);
    }
}
