@inject ICategoryService CategoryService
@inject CurrentUserService CurrentUser
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_model.Name" Label="Название" Required="true" Class="mb-3" />
        <MudSelect T="TransactionType" @bind-Value="_model.Type" Label="Тип" Class="mb-3">
            <MudSelectItem Value="TransactionType.Expense">Расход</MudSelectItem>
            <MudSelectItem Value="TransactionType.Income">Доход</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_model.Color" Label="Цвет (#hex)" Class="mb-3" />
        <MudTextField @bind-Value="_model.Icon" Label="Иконка (опционально)" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private CreateCategoryDto _model = new() { Type = TransactionType.Expense };

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;
        await CategoryService.CreateAsync(userId, _model);
        Snackbar.Add("Категория создана", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
