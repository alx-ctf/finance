@page "/categories"
@attribute [Authorize]
@inject ICategoryService CategoryService
@inject CurrentUserService CurrentUser
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageStyleLink Href="css/pages/categories.css" />
<PageTitle>Категории</PageTitle>

<div class="page-categories ft-page">
    <div class="ft-page-toolbar">
        <MudText Typo="Typo.h4" Class="ft-page-title mb-0">Категории</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">Добавить</MudButton>
    </div>

    <MudTabs>
        <MudTabPanel Text="Расходы">
            <MudTable Items="_expenses" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Категория</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudChip T="string" Class="ft-category-chip" Style="@($"background:{context.Color}")">@context.Name</MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="() => DeleteAsync(context.Id)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="Доходы">
            <MudTable Items="_incomes" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Категория</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudChip T="string" Class="ft-category-chip" Style="@($"background:{context.Color}")">@context.Name</MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="() => DeleteAsync(context.Id)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private List<CategoryDto> _expenses = [];
    private List<CategoryDto> _incomes = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;
        var all = (await CategoryService.GetAllAsync(userId)).ToList();
        _expenses = all.Where(c => c.Type == TransactionType.Expense).ToList();
        _incomes = all.Where(c => c.Type == TransactionType.Income).ToList();
    }

    private async Task OpenCreate()
    {
        var result = await DialogService.ShowAsync<CategoryDialog>("Новая категория");
        if ((await result.Result)?.Canceled == false)
            await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;

        try
        {
            await CategoryService.DeleteAsync(id, userId);
            Snackbar.Add("Категория удалена", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
