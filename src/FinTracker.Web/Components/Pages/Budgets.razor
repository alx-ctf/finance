@page "/budgets"
@attribute [Authorize]
@inject IBudgetService BudgetService
@inject ICategoryService CategoryService
@inject CurrentUserService CurrentUser
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Бюджеты</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Бюджеты — @DateTime.Today.ToString("MMMM yyyy")</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">Добавить</MudButton>
</MudStack>

<MudGrid Spacing="3">
    @foreach (var b in _items)
    {
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1">@b.CategoryName</MudText>
                <MudText Typo="Typo.body2">@b.SpentAmount.ToString("N0") / @b.LimitAmount.ToString("N0") ₽</MudText>
                <MudProgressLinear Value="@b.UsagePercent" Max="100" Color="@GetColor(b.UsagePercent)" Class="mt-2" />
                <MudText Typo="Typo.caption">Остаток: @b.Remaining.ToString("N0") ₽</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               Class="mt-2" OnClick="() => DeleteAsync(b.Id)" />
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private List<BudgetDto> _items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;
        _items = (await BudgetService.GetAllAsync(userId, DateTime.Today.Year, DateTime.Today.Month)).ToList();
    }

    private static Color GetColor(double percent) => percent switch
    {
        >= 100 => Color.Error,
        >= 80 => Color.Warning,
        _ => Color.Success
    };

    private async Task OpenCreate()
    {
        var result = await DialogService.ShowAsync<BudgetDialog>("Новый бюджет");
        if ((await result.Result)?.Canceled == false)
            await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;
        await BudgetService.DeleteAsync(id, userId);
        Snackbar.Add("Бюджет удалён", Severity.Success);
        await LoadAsync();
    }
}
