@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Вход</PageTitle>

<div class="page-login">
    <div class="ft-auth-card">
        <h1 class="ft-auth-title">Вход</h1>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="ft-auth-error" role="alert">@_error</div>
        }

        <form method="post" action="@_loginAction" class="ft-auth-form">
            <AntiforgeryToken />
            <div class="ft-field">
                <label for="email">Email</label>
                <input id="email" type="email" name="Email" required autocomplete="username" placeholder="you@example.com" />
            </div>
            <div class="ft-field">
                <label for="password">Пароль</label>
                <input id="password" type="password" name="Password" required autocomplete="current-password" placeholder="••••••••" />
            </div>
            <button type="submit" class="ft-btn-primary">Войти</button>
        </form>

        <div class="ft-auth-link-wrap">
            <a href="/register" class="ft-auth-link">Регистрация</a>
        </div>

        <div class="ft-demo-hint">
            Демо: <strong>demo@fintracker.local</strong> / <strong>Demo123!</strong>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string? _error;
    private string _loginAction = "/auth/login";

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl) &&
            ReturnUrl.StartsWith('/') &&
            !ReturnUrl.StartsWith("//"))
        {
            _loginAction = $"/auth/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
        }

        _error = ErrorCode switch
        {
            "invalid" => "Неверный email или пароль",
            "empty" => "Заполните email и пароль",
            _ => null
        };
    }
}
