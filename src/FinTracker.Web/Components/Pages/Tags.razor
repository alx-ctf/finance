@page "/tags"
@attribute [Authorize]
@inject ITagService TagService
@inject CurrentUserService CurrentUser
@inject ISnackbar Snackbar

<PageStyleLink Href="css/pages/tags.css" />
<PageTitle>Теги</PageTitle>

<div class="page-tags ft-page">
    <MudText Typo="Typo.h4" Class="ft-page-title">Теги</MudText>

    <MudGrid Class="ft-tag-form">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_newName" Label="Название" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_newColor" Label="Цвет" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Class="mt-4">Добавить</MudButton>
        </MudItem>
    </MudGrid>

    <MudChipSet T="string">
        @foreach (var t in _items)
        {
            <MudChip T="string" Closeable="true" Class="ft-tag-chip" Style="@($"background:{t.Color}")" OnClose="() => DeleteAsync(t.Id)">@t.Name</MudChip>
        }
    </MudChipSet>
</div>

@code {
    private List<TagDto> _items = [];
    private string _newName = "";
    private string _newColor = "#9E9E9E";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is not null)
            _items = (await TagService.GetAllAsync(userId)).ToList();
    }

    private async Task CreateAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null || string.IsNullOrWhiteSpace(_newName)) return;

        try
        {
            await TagService.CreateAsync(userId, new CreateTagDto { Name = _newName, Color = _newColor });
            _newName = "";
            Snackbar.Add("Тег добавлен", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(int id)
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;

        try
        {
            await TagService.DeleteAsync(id, userId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
