@inherits LayoutComponentBase

<MudLayout Class="ft-layout">
    <MudAppBar Elevation="0" Class="ft-layout-appbar">
        <MudText Typo="Typo.h6" Class="ml-3">Финансовый трекер</MudText>
        <MudSpacer />
        <ThemeToggle />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="ft-layout-user">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Href="/logout" />
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/login">Вход</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Persistent">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="ft-layout-main pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Обновить</a>
    <span class="dismiss">🗙</span>
</div>

